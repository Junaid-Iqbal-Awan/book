# App runtime
PART1_APP_PORT=5000
PART2_APP_PORT=5001
PORT=5000
NODE_ENV=production

# Admin user email used by backend auth checks
ADMIN_EMAIL=junaidiqbalpro19@gmail.com

# MongoDB URI values are set by docker-compose service names by default.
# Keep this for local non-docker runs.
MONGO_URI=mongodb://127.0.0.1:27017/hogwarts_bookstore

# Persist uploaded images inside the mounted app volume
UPLOAD_DIR=/app/Backend/public
